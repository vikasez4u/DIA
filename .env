# Digital Inclusivity Auditor Configuration
# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=dia_database
DATABASE_TYPE=mysql
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/dia_database

# API Configuration
API_HOST=127.0.0.1
API_PORT=5000

# Optional: External API Keys (set these if you have them)
# GOOGLE_API_KEY=your-google-api-key
# OPENAI_API_KEY=your-openai-api-key

# Optional: Model Paths (set these if you have custom models)
# GENDER_MODEL_PATH=weights/gender_net.caffemodel
# FACE_MODEL_PATH=weights/deploy.prototxt

# Tesseract Configuration (set this based on your installation)
# For Windows: TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# For Linux: TESSERACT_PATH=/usr/bin/tesseract
# For macOS: TESSERACT_PATH=/usr/local/bin/tesseract
# TESSERACT_PATH=

# Project Paths (relative to project root)
PROJECT_ROOT=.
WEIGHTS_DIR=weights
UPLOADS_DIR=backend/uploads
LOGS_DIR=backend/logs
